---
import '../styles/site.css';
import { caseKeys, casePath, getCase } from '../data/cases';
const { lang, project } = Astro.props;
const en = lang === 'en';
const data = getCase(lang, project);
const position = caseKeys.indexOf(project);
const adjacent = [caseKeys[position - 1], caseKeys[position + 1]];
const home = en ? '/en' : '/';
const url = (path) => new URL(path, Astro.site).href;
const title = data.title + ' · Lucas Nieto';
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={data.intro} />
    <link rel="icon" href="/favicon.svg" />
    <link rel="canonical" href={url(casePath(lang, project))} />
    <link rel="alternate" hreflang="es" href={url(casePath('es', project))} />
    <link rel="alternate" hreflang="en" href={url(casePath('en', project))} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={data.headline} />
    <meta property="og:image" content={url('/' + data.image.src)} />
    <meta property="og:url" content={url(casePath(lang, project))} />
    <meta property="og:type" content="article" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline src="/theme-init.js"></script>
  </head>
  <body>
    <a class="skip" href="#main">{en ? 'Skip to content' : 'Ir al contenido'}</a>
    <header class="site-header glass">
      <div class="wrap header-row case-header">
        <a class="brand" href={home}>Lucas Nieto</a>
        <div class="languages" aria-label={en ? 'Language' : 'Idioma'}>
          <a href={casePath('es', project)} lang="es" aria-current={!en ? 'page' : undefined}>ES</a>
          <a href={casePath('en', project)} lang="en" aria-current={en ? 'page' : undefined}>EN</a>
        </div>
      </div>
    </header>
    <main class="wrap case-page" id="main">
      <a class="text-link case-back" href={home + '#proyectos'}>← {en ? 'Selected projects' : 'Proyectos seleccionados'}</a>
      <div class="case-grid">
        <div>
          <p class="eyebrow">{data.title}</p>
          <h1>{data.headline}</h1>
          <p class="intro">{data.intro}</p>
          <div class="work-actions">
            <a class="action primary" href={data.demo.startsWith('https:') ? data.demo : '/' + data.demo}>{project === 'taskapi' ? (en ? 'Open simulated lab' : 'Abrir laboratorio simulado') : (en ? 'Try the demo' : 'Probar la demo')} ↗</a>
            <a class="action secondary" href={data.code}>{en ? 'View code' : 'Ver código'} ↗</a>
            {data.backend && <a class="text-link" href={data.backend}>Backend ↗</a>}
          </div>
          <p class="contact-note mt-4">{data.mode}</p>
        </div>
        <figure class="case-capture surface">
          <img src={'/' + data.image.src} alt={data.image.alt} width={data.image.width} height={data.image.height} decoding="async" />
          <figcaption>{en ? 'Public demo' : 'Demo pública'} · {data.title}</figcaption>
        </figure>
      </div>
      <div class="case-grid case-details">
        <section class="surface">
          <h2>{en ? 'Try this workflow' : 'Prueba este recorrido'}</h2>
          <ol>{data.steps.map(step => <li>{step}</li>)}</ol>
        </section>
        <section class="surface">
          <h2>{en ? 'Technical decision' : 'Decisión técnica'}</h2>
          <p>{data.decision}</p>
        </section>
      </div>
      <nav class="case-navigation" aria-label={en ? 'Browse project cases' : 'Navegar entre casos'}>
        {adjacent.map((key, index) => key && (
          <a class="surface" rel={index ? 'next' : 'prev'} href={casePath(lang, key)}>
            <span>{index ? (en ? 'Next project' : 'Proyecto siguiente') : (en ? 'Previous project' : 'Proyecto anterior')}</span>
            <strong>{getCase(lang, key).title}</strong>
            <span class="case-direction" aria-hidden="true">{index ? '→' : '←'}</span>
          </a>
        ))}
      </nav>
      <a class="text-link" href={home + '#contacto'}>{en ? 'Contact Lucas' : 'Contactar a Lucas'} →</a>
    </main>
    <footer class="wrap footer"><p>© {new Date().getFullYear()} Lucas Nieto</p></footer>
    <script>
      import '../scripts/capture-motion.js';
    </script>
  </body>
</html>
