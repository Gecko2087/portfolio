---
import '../styles/site.css';
import { channelsPaths, channelsTitles } from '../data/contact-channels.js';
const { lang } = Astro.props;
const en = lang === 'en';
const home = en ? '/en' : '/';
const title = channelsTitles[lang];
const description = en
  ? 'I set up Facebook, Instagram and WhatsApp Business for a sales operation and designed three n8n workflows for handling inquiries.'
  : 'Configuré Facebook, Instagram y WhatsApp Business para una operación comercial y diseñé tres flujos de atención en n8n.';
const delivered = en ? [
  ['Facebook and advertising', 'I set up the Facebook Page and ad account in Meta Business Suite and assigned access permissions to the business assets.'],
  ['Instagram', 'I created the business profile and linked it to the Facebook Page.'],
  ['WhatsApp Business', 'I set it up as a contact channel for sales inquiries.'],
] : [
  ['Facebook y publicidad', 'Configuré la página de Facebook y la cuenta publicitaria en Meta Business Suite, y asigné permisos de acceso a los activos comerciales.'],
  ['Instagram', 'Creé el perfil comercial y lo vinculé con la página de Facebook.'],
  ['WhatsApp Business', 'Lo dejé configurado como canal de contacto para consultas comerciales.'],
];
const connections = en ? [
  ['One planned line', 'Meta WhatsApp Cloud API'],
  ['Two planned lines', 'WAHA · unofficial connections'],
] : [
  ['Una línea prevista', 'WhatsApp Cloud API de Meta'],
  ['Dos líneas previstas', 'WAHA · conexiones no oficiales'],
];
// This independent teaching example does not reconstruct the unavailable originals.
const demo = en ? {
  stages: ['Incoming inquiry', 'Illustrative n8n route', 'Prepared response', 'Human handoff'],
  routes: [
    { name: 'Product inquiry', source: 'Demo line A · Cloud API', message: 'Hello! I would like to know more about the demo service.', rule: 'Example rule: identify a general information request.', response: 'Thanks for reaching out. What would you like to know about our demo service?', handoff: 'A person can continue the conversation with the inquiry context.' },
    { name: 'Opening hours', source: 'Demo line B · WAHA (unofficial)', message: 'What are the opening hours of your fictional branch?', rule: 'Example rule: recognize a question about opening hours.', response: 'Fictional hours: Monday to Friday, 9 am–5 pm. Would you like a person to help?', handoff: 'The example leaves the hours question and the prepared reply ready for a person.' },
    { name: 'Talk to a person', source: 'Demo line C · WAHA (unofficial)', message: 'I would prefer to speak to someone about my inquiry.', rule: 'Example rule: detect an explicit request for human assistance.', response: 'Your request is ready to be passed to a person in this local example.', handoff: 'Illustrative pending handoff. No conversation is assigned or sent.' },
  ],
  details: ['A fictional message enters the selected example line.', 'The example shows a possible routing decision. It does not execute n8n.', 'A draft answer is displayed locally. No message is sent.', 'The local example ends with context ready for a person.'],
  step: 'Step', of: 'of', source: 'Example entry', incoming: 'Fictional inquiry', rule: 'Illustrative decision', response: 'Unsent response', handoff: 'Example outcome',
} : {
  stages: ['Consulta entrante', 'Ruta ilustrativa en n8n', 'Respuesta preparada', 'Derivación humana'],
  routes: [
    { name: 'Consulta comercial', source: 'Línea ficticia A · Cloud API', message: '¡Hola! Quiero conocer más sobre el servicio de ejemplo.', rule: 'Regla de ejemplo: identificar una solicitud de información general.', response: 'Gracias por escribir. ¿Qué te gustaría conocer sobre nuestro servicio ficticio?', handoff: 'Una persona podría continuar la conversación con el contexto de la consulta.' },
    { name: 'Horarios de atención', source: 'Línea ficticia B · WAHA (no oficial)', message: '¿En qué horario atiende la sucursal ficticia?', rule: 'Regla de ejemplo: reconocer una pregunta sobre horarios.', response: 'Horario ficticio: lunes a viernes de 9 a 17 h. ¿Querés que te ayude una persona?', handoff: 'El ejemplo deja disponibles la consulta de horarios y la respuesta preparada para una persona.' },
    { name: 'Hablar con una persona', source: 'Línea ficticia C · WAHA (no oficial)', message: 'Prefiero hablar con alguien sobre mi consulta.', rule: 'Regla de ejemplo: detectar un pedido explícito de atención humana.', response: 'En este ejemplo local, tu consulta está preparada para pasar a una persona.', handoff: 'Derivación pendiente ilustrativa. No se asigna ni se envía ninguna conversación.' },
  ],
  details: ['Un mensaje ficticio ingresa por la línea elegida para el ejemplo.', 'El ejemplo muestra una posible decisión de atención. No ejecuta n8n.', 'Se muestra un borrador de respuesta local. No se envía ningún mensaje.', 'El recorrido local termina con el contexto preparado para una persona.'],
  step: 'Paso', of: 'de', source: 'Entrada de ejemplo', incoming: 'Consulta ficticia', rule: 'Decisión ilustrativa', response: 'Respuesta sin enviar', handoff: 'Resultado de ejemplo',
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title} · Lucas Nieto</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={new URL(channelsPaths[lang], Astro.site)} />
    <link rel="alternate" hreflang="es" href={new URL(channelsPaths.es, Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(channelsPaths.en, Astro.site)} />
    <script is:inline src="/theme-init.js"></script>
  </head>
  <body>
    <a class="skip" href="#main">{en ? 'Skip to content' : 'Ir al contenido'}</a>
    <header class="site-header glass"><div class="wrap header-row">
      <a class="brand" href={home}>Lucas Nieto</a>
      <div class="languages" aria-label={en ? 'Language' : 'Idioma'}>
        <a href={channelsPaths.es} lang="es" aria-current={!en ? 'page' : undefined}>ES</a>
        <a href={channelsPaths.en} lang="en" aria-current={en ? 'page' : undefined}>EN</a>
      </div>
    </div></header>
    <main class="wrap case-page" id="main">
      <a class="text-link case-back" href={home + '#trabajo-independiente'}>← {en ? 'Independent work' : 'Trabajo independiente'}</a>
      <div class="channel-intro">
        <p class="eyebrow">{en ? 'Independent work' : 'Trabajo independiente'}</p>
        <h1>{title}</h1>
        <p class="intro">{description}</p>
      </div>
      <section class="surface channel-panel" aria-labelledby="channel-delivery">
        <h2 id="channel-delivery">{en ? 'What I delivered' : 'Trabajo entregado'}</h2>
        <p>{en ? 'The business assets and their permissions were organized in Meta Business Suite. Facebook and Instagram were linked, and WhatsApp Business was set up for direct customer inquiries.' : 'Los activos comerciales y sus permisos quedaron organizados en Meta Business Suite. Facebook e Instagram quedaron vinculados y WhatsApp Business quedó habilitado para recibir consultas directas.'}</p>
        <dl class="channel-grid">
          {delivered.map(([label, detail]) => <div><span class="channel-status">{en ? 'Delivered' : 'Entregado'}</span><dt>{label}</dt><dd>{detail}</dd></div>)}
        </dl>
      </section>
      <section class="surface channel-panel" aria-labelledby="channel-prototype">
        <h2 id="channel-prototype">{en ? 'Automation prototypes' : 'Prototipos de automatización'}</h2>
        <span class="channel-status channel-paused">{en ? 'Paused · not deployed' : 'Pausado · sin despliegue'}</span>
        <p>{en ? 'I built three inquiry-handling workflows in n8n. The client did not confirm whether to proceed, and the project paused before deployment.' : 'Desarrollé tres flujos de atención con n8n. El trabajo quedó pausado antes del despliegue porque el cliente no confirmó la continuidad.'}</p>
        <figure class="channel-diagram">
          <figcaption>{en ? 'Planned architecture' : 'Arquitectura prevista'}</figcaption>
          <ul class="channel-grid">
            {connections.map(([label, integration]) => <li><span>{label}</span><strong>{integration}</strong></li>)}
          </ul>
          <p class="channel-target"><span aria-hidden="true">↓</span> <strong>n8n</strong> · {en ? 'Three inquiry-handling workflows' : 'Tres flujos de atención'}</p>
        </figure>
      </section>
      <section class="surface channel-panel channel-demo" aria-labelledby="demo-title" data-channel-demo data-demo={JSON.stringify(demo)}>
        <div class="demo-heading"><div><p class="eyebrow">{en ? 'Explore the concept' : 'Explorá el concepto'}</p><h2 id="demo-title">{en ? 'From inquiry to human assistance' : 'De la consulta a la atención humana'}</h2></div><span class="channel-status">{en ? 'Fictional data · local demo' : 'Datos ficticios · demo local'}</span></div>
        <p class="demo-disclosure">{en ? 'The original workflows and screenshots were not located. This independent illustration explains a possible inquiry journey; it does not reproduce their steps or prove their operation. The three scenarios below are examples, not a description of the three original workflows.' : 'No se localizaron los flujos ni las capturas originales. Esta ilustración independiente explica un posible recorrido de atención; no reproduce sus pasos ni acredita su funcionamiento. Los tres escenarios de abajo son ejemplos, no una descripción de los tres flujos originales.'}</p>
        <div class="demo-route-picker" role="group" aria-label={en ? 'Choose a fictional scenario' : 'Elegí un escenario ficticio'}>
          {demo.routes.map((route, index) => <button type="button" data-route={index} aria-pressed={index === 0}>{route.name}</button>)}
        </div>
        <div class="demo-workspace">
          <div class="demo-map">
            <div class="demo-map-top"><span>01 → 04</span><span>{en ? 'Illustrative journey' : 'Recorrido ilustrativo'}</span></div>
            <ol class="demo-nodes" aria-label={en ? 'Journey steps' : 'Pasos del recorrido'}>
              {demo.stages.map((stage, index) => <li><button type="button" data-step={index} aria-current={index === 0 ? 'step' : undefined}><span class="node-number">0{index + 1}</span><span><strong>{stage}</strong><small>{[en ? 'Fictional message' : 'Mensaje ficticio', en ? 'Example rule' : 'Regla de ejemplo', en ? 'Draft only' : 'Sólo borrador', en ? 'End of example' : 'Fin del ejemplo'][index]}</small></span><span aria-hidden="true">↗</span></button></li>)}
            </ol>
            <p class="demo-boundary">{en ? 'No network requests, active sessions or real messages.' : 'Sin solicitudes de red, sesiones activas ni mensajes reales.'}</p>
          </div>
          <div class="demo-inspector" aria-live="polite" aria-atomic="true">
            <div class="inspector-top"><span data-progress>{demo.step} 1 {demo.of} 4</span><span class="demo-dot" aria-hidden="true"></span></div>
            <h3 data-stage-title>{demo.stages[0]}</h3><p class="demo-explanation" data-stage-description>{demo.details[0]}</p>
            <dl class="demo-record">
              <div><dt>{demo.source}</dt><dd data-source>{demo.routes[0].source}</dd></div>
              <div class="demo-message"><dt data-record-label>{demo.incoming}</dt><dd data-record-value>{demo.routes[0].message}</dd></div>
            </dl>
            <div class="demo-controls"><button type="button" data-previous disabled>{en ? '← Previous' : '← Anterior'}</button><button type="button" data-next>{en ? 'Next →' : 'Siguiente →'}</button></div>
            <button type="button" class="demo-reset" data-reset>{en ? 'Restart this scenario' : 'Reiniciar este escenario'}</button>
          </div>
        </div>
        <noscript><p>{en ? 'Enable JavaScript to explore the four steps and switch scenarios. The first example is shown above.' : 'Activá JavaScript para recorrer los cuatro pasos y cambiar de escenario. Arriba se muestra el primer ejemplo.'}</p></noscript>
        <details class="demo-capture"><summary>{en ? 'How to capture this synthetic example' : 'Cómo capturar este ejemplo sintético'}</summary><p>{en ? 'Choose a scenario and a step, then capture this section in your browser. Keep the “Fictional data · local demo” label and this disclosure visible. Any later image must be labeled as a synthetic illustration, separate from original project evidence. This page does not connect to Meta, WAHA or n8n.' : 'Elegí un escenario y un paso, y capturá esta sección desde el navegador. Conservá visibles la etiqueta “Datos ficticios · demo local” y la aclaración de alcance. Toda imagen posterior debe identificarse como ilustración sintética, separada de la evidencia original del proyecto. Esta página no conecta con Meta, WAHA ni n8n.'}</p></details>
      </section>
    </main>
    <script>import '../scripts/contact-channels.js';</script>
  </body>
</html>

<style>
  .channel-intro { margin-block: 16px 32px; }
  .channel-intro h1 { font: 700 clamp(2.25rem, 6vw, 4.6rem)/1.06 var(--font-display); max-width: 19ch; margin-block: .4rem 1rem; }
  .channel-intro .intro { max-width: 64ch; }
  .channel-panel { padding: clamp(18px, 3vw, 32px); margin-block: 1rem; }
  .channel-panel h2 { font: 700 clamp(1.4rem, 3vw, 2rem)/1.2 var(--font-display); margin-bottom: .55rem; }
  .channel-panel p, dd, .channel-diagram li span { color: var(--muted); }
  .channel-grid { display: grid; gap: .7rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); margin-top: 1rem; }
  .channel-grid > * { padding: .85rem 1rem; border-radius: .7rem; background: var(--inset); border: 1px solid var(--line); }
  dt, figcaption { font-weight: 700; }
  dd { margin-top: .3rem; }
  .channel-diagram { margin-top: 1.25rem; }
  .channel-diagram li strong { display: block; margin-top: .2rem; }
  .channel-target { padding: .7rem 0 0; }
  .channel-target span { color: var(--accent); padding-inline-end: .35rem; }
  .channel-status { display: inline-block; font-size: .72rem; font-weight: 700; letter-spacing: .025em; padding: .35rem .6rem; border: 1px solid var(--line); border-radius: 2rem; color: var(--accent); margin-bottom: .65rem; }
  .channel-paused { color: var(--ink); }
  .demo-heading { display: flex; justify-content: space-between; align-items: start; gap: 1rem; }
  .demo-heading .eyebrow { margin-bottom: .55rem; }
  .demo-heading .channel-status { flex-shrink: 0; }
  .demo-disclosure { max-width: 90ch; font-size: .88rem; line-height: 1.7; }
  .demo-route-picker { display: flex; flex-wrap: wrap; gap: .5rem; margin-block: 1.5rem; }
  .demo-route-picker button, .demo-controls button { border: 1px solid var(--line); border-radius: .6rem; padding: .75rem 1rem; font-weight: 600; font-size: .85rem; min-height: 44px; background: var(--inset); }
  .demo-route-picker button[aria-pressed="true"] { background: var(--button); color: var(--button-text); border-color: var(--button); }
  .demo-workspace { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .demo-map, .demo-inspector { border: 1px solid var(--line); border-radius: 1rem; padding: clamp(16px, 2.5vw, 28px); background: var(--inset); min-width: 0; }
  .demo-map-top, .inspector-top { display: flex; justify-content: space-between; gap: 1rem; color: var(--muted); font-size: .72rem; letter-spacing: .03em; margin-bottom: 1.5rem; }
  .demo-map-top > :first-child { color: var(--accent); }
  .demo-nodes { list-style: none; margin: 0; padding: 0; }
  .demo-nodes li + li::before { content: ''; display: block; height: 20px; border-left: 2px dashed var(--line); margin-left: 27px; }
  .demo-nodes button { display: flex; align-items: center; gap: .85rem; width: 100%; text-align: left; padding: .85rem; border-radius: .7rem; border: 1px solid var(--line); background: var(--surface); }
  .demo-nodes button[aria-current="step"] { border-color: var(--accent); box-shadow: inset 3px 0 var(--accent); }
  .node-number { color: var(--accent); font: 600 .85rem var(--font-display); }
  .demo-nodes strong { display: block; font-size: .88rem; }
  .demo-nodes small { display: block; color: var(--muted); font-size: .74rem; margin-top: .25rem; }
  .demo-nodes button > :last-child { margin-left: auto; color: var(--muted); }
  .channel-panel .demo-boundary { font-size: .75rem; margin-top: 1.4rem; line-height: 1.6; }
  .demo-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--accent); align-self: center; }
  .demo-inspector { display: flex; flex-direction: column; }
  .demo-inspector h3 { font: 700 clamp(1.3rem, 2.5vw, 1.8rem)/1.2 var(--font-display); }
  .demo-explanation { font-size: .85rem; line-height: 1.65; margin-top: .75rem; }
  .demo-record { margin-block: 1.5rem; }
  .demo-record dt { font-size: .7rem; text-transform: uppercase; letter-spacing: .07em; color: var(--muted); }
  .demo-record dd { color: var(--ink); font-size: .88rem; line-height: 1.7; }
  .demo-message { border-left: 2px solid var(--accent); margin-top: 1.25rem; padding: .8rem 1rem; background: var(--surface); border-radius: 0 .7rem .7rem 0; min-height: 130px; }
  .demo-controls { display: flex; justify-content: space-between; gap: 1rem; margin-top: auto; }
  .demo-controls button[data-next] { background: var(--button); color: var(--button-text); }
  .demo-reset { align-self: start; margin-top: .9rem; min-height: 44px; font-size: .75rem; color: var(--muted); text-decoration: underline; text-underline-offset: 4px; }
  .demo-capture { border-top: 1px solid var(--line); margin-top: 1.5rem; padding-top: 1rem; font-size: .82rem; }
  .demo-capture summary { cursor: pointer; padding-block: .5rem; font-weight: 600; }
  .demo-capture p { line-height: 1.7; margin-top: .5rem; }
  @media (max-width: 700px) { .demo-workspace { grid-template-columns: 1fr; } .demo-heading { display: block; } .demo-heading .channel-status { margin-top: .5rem; } .demo-route-picker button { flex-grow: 1; } }
</style>
