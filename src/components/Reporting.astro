---
import '../styles/site.css';
const { lang } = Astro.props;
const en = lang === 'en';
const home = en ? '/en' : '/';
const esPath = '/proyectos/control-informes';
const enPath = '/en/projects/reporting';
const title = en ? 'Reporting automation' : 'Automatización de informes';
const description = en
  ? 'I automated source downloads, data reconciliation, workbook generation and scheduled delivery for operations reports.'
  : 'Automaticé la descarga de fuentes, la conciliación de datos, la generación de planillas y el envío programado de informes operativos.';
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title} · Lucas Nieto</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={new URL(en ? enPath : esPath, Astro.site)} />
    <link rel="alternate" hreflang="es" href={new URL(esPath, Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(enPath, Astro.site)} />
    <script is:inline src="/theme-init.js"></script>
  </head>
  <body>
    <a class="skip" href="#main">{en ? 'Skip to content' : 'Ir al contenido'}</a>
    <header class="site-header glass"><div class="wrap header-row">
      <a class="brand" href={home}>Lucas Nieto</a>
      <div class="languages" aria-label={en ? 'Language' : 'Idioma'}>
        <a href={esPath} lang="es" aria-current={!en ? 'page' : undefined}>ES</a>
        <a href={enPath} lang="en" aria-current={en ? 'page' : undefined}>EN</a>
      </div>
    </div></header>
    <main class="wrap case-page reporting" id="main">
      <a class="text-link case-back" href={home + '#impacto'}>← {en ? 'Experience and impact' : 'Experiencia e impacto'}</a>
      <div class="case-grid">
        <div><p class="eyebrow">{en ? 'Operations automation' : 'Automatización de operaciones'}</p><h1>{title}</h1></div>
        <p class="intro">{description}</p>
      </div>
      <section class="surface report-panel" aria-labelledby="report-impact">
        <div>
          <p class="eyebrow">{en ? 'October 2026 · operations reporting' : 'Octubre de 2026 · informes operativos'}</p>
          <h2 id="report-impact">{en ? '243 distinct reporting runs' : '243 cortes distintos de informes'}</h2>
          <p>{en ? 'Execution records cover 10 report families and add up to 28 h 43 min of automated processing. I counted the first recorded successful run for each reporting period in each family.' : 'Los registros cubren 10 familias de informes y suman 28 h 43 min de ejecución automática. Para cada período y familia, conté la primera ejecución exitosa registrada.'}</p>
        </div>
      </section>
      <section class="surface report-panel" aria-labelledby="manual-estimate">
        <h2 id="manual-estimate">{en ? '150–299 hours of estimated manual work' : '150–299 horas de trabajo manual estimado'}</h2>
        <p>{en ? 'For 221 comparable reporting runs, I estimated the manual minutes required for downloading, preparing, checking and delivering each report, then multiplied by the run count for each family. The other 22 runs were audits whose effort depends on the number of cases in each batch.' : 'Para los 221 cortes comparables, estimé los minutos que habría llevado descargar, preparar, revisar y entregar cada informe. Multipliqué ese esfuerzo por la cantidad de cortes de cada familia. Los otros 22 fueron auditorías cuyo esfuerzo depende de la cantidad de casos de cada lote.'}</p>
      </section>
      <section class="surface report-panel" aria-labelledby="savings-estimate">
        <h2 id="savings-estimate">{en ? '129–279 hours of potential savings' : '129–279 horas de ahorro potencial'}</h2>
        <p>{en ? 'This scenario deducts five minutes of human review for each of the 221 comparable runs and two hours of shared maintenance. Measuring actual savings requires timing review and rework, and confirming which reports the team would have produced manually.' : 'Este escenario descuenta cinco minutos de revisión humana por cada uno de los 221 cortes comparables y dos horas de mantenimiento común. Para calcular el ahorro real, falta cronometrar la revisión y las correcciones, y confirmar qué informes habría preparado manualmente el equipo.'}</p>
      </section>
    </main>
  </body>
</html>

<style>
  .reporting .case-grid { align-items: end; margin-block: 16px 30px; }
  .report-panel { display: grid; gap: 18px; margin-block: 16px; padding: clamp(18px, 3vw, 32px); }
  .report-panel h2 { font: 700 clamp(1.4rem, 3vw, 2rem)/1.14 var(--font-display); margin-block: 5px 9px; }
  .report-panel p:not(.eyebrow) { color: var(--muted); max-width: 80ch; }
</style>
