---
import BrandMark from './BrandMark.astro';
import { channelsPaths, channelsTitles } from '../data/contact-channels.js';
const { lang, projects } = Astro.props;
const en = lang === 'en';
const operations = en ? [
  { title: 'Operations intranet', detail: 'Trace a call assessment back to the exact excerpt a reviewer needs to check.', href: '/en/projects/operations-intranet', cta: 'See call evidence' },
  { title: 'Ticket quality review', detail: 'Review three fictional tickets and decide whether the flagged message warrants follow-up.', href: '/en/projects/quality-review', cta: 'Open the review queue' },
  { title: 'Service recovery', detail: 'See how a backup was restored and checked in a reproducible exercise.', href: '/en/projects/service-recovery', cta: 'See the recovery test' },
] : [
  { title: 'Intranet de operaciones', detail: 'Ve de una evaluación de calidad al fragmento exacto de la llamada que necesita revisar el analista.', href: '/proyectos/intranet-operaciones', cta: 'Ver evidencia de una llamada' },
  { title: 'Revisión de calidad de tickets', detail: 'Revisa tres tickets ficticios y decide si el mensaje señalado requiere seguimiento.', href: '/proyectos/revision-calidad', cta: 'Abrir la cola de revisión' },
  { title: 'Recuperación de un servicio', detail: 'Mira cómo se restauró y verificó una copia en un ensayo reproducible.', href: '/proyectos/recuperacion-servicio', cta: 'Ver ensayo de recuperación' },
];
---
<section class="wrap section-space" id="proyectos">
  <h2 class="section-title mb-7">{en ? 'Selected projects' : 'Proyectos seleccionados'}</h2>
  <section id="casos-operativos" class="operations-projects" aria-labelledby="operations-heading">
    <h3 id="operations-heading">{en ? 'Operations case studies' : 'Casos de operaciones'}</h3>
    <div class="grid gap-4 md:grid-cols-3">
      {operations.map(item => <article class="surface operations-card">
        <h4>{item.title}</h4>
        <p>{item.detail}</p>
        <a class="text-link motion-link" href={item.href}>{item.cta} <span aria-hidden="true">→</span></a>
      </article>)}
    </div>
  </section>
  <div class="grid gap-5 md:grid-cols-2 md:gap-6">
    {projects.map(project => (
      <article class:list={['project-card', { 'compact-project': ['passforge', 'taskapi'].includes(project.key) }]} data-reveal data-tone={project.key} id={'project-' + project.key}>
        <div class="work-visual">
          <a class="work-image" href={project.demo} target={project.demo.startsWith('https:') ? '_blank' : undefined} rel={project.demo.startsWith('https:') ? 'noopener noreferrer' : undefined} aria-label={(en ? 'Try ' : 'Probar ') + project.title}>
            <img src={'/' + project.image.src} alt={project.image.alt} width={project.image.width} height={project.image.height} loading="lazy" decoding="async" />
          </a>
          <button class="card-expand" type="button" data-capture={project.key} aria-label={(en ? 'Enlarge screenshot of ' : 'Ampliar captura de ') + project.title}>⤢</button>
        </div>
        <div class="project-content">
          <h3>{project.title}</h3>
          <p>{project.description}</p>
          <p class="stack">{project.stack.map(name => <span><BrandMark name={name} />{name}</span>)}</p>
          <div class="work-actions">
            <a class="action primary demo-button" href={project.demo} target={project.demo.startsWith('https:') ? '_blank' : undefined} rel={project.demo.startsWith('https:') ? 'noopener noreferrer' : undefined}>{project.key === 'taskapi' ? (en ? 'Simulated lab' : 'Laboratorio simulado') : (en ? 'Try demo' : 'Probar demo')} ↗</a>
            <a class="action secondary" href={(en ? '/en/projects/' : '/proyectos/') + project.key}>{en ? 'Case study' : 'Ver caso'} <span class="link-arrow" aria-hidden="true">→</span></a>
            <a class="text-link motion-link" href={project.code} target="_blank" rel="noopener noreferrer">{en ? 'Code' : 'Código'} <span class="link-arrow" aria-hidden="true">↗</span></a>
          </div>
        </div>
      </article>
    ))}
  </div>
  <section class="quality-teaser surface" id="trabajo-independiente" aria-labelledby="independent-project">
    <div>
      <p class="eyebrow">{en ? 'Independent work' : 'Trabajo independiente'}</p>
      <h3 id="independent-project">{channelsTitles[lang]}</h3>
      <p>{en ? 'Facebook, Instagram and WhatsApp Business setup, with three n8n automation prototypes.' : 'Configuración de Facebook, Instagram y WhatsApp Business, con tres prototipos de automatización en n8n.'}</p>
    </div>
    <a class="action secondary" href={channelsPaths[lang]}>{en ? 'View independent case' : 'Ver trabajo independiente'} →</a>
  </section>
</section>
