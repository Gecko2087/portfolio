---
const { lang, projects } = Astro.props;
const en = lang === 'en';
---
<section class="wrap section-space" id="proyectos">
  <h2 class="section-title mb-7">{en ? 'Selected projects' : 'Proyectos seleccionados'}</h2>
  <div class="grid gap-5 md:grid-cols-2 md:gap-6">
    {projects.map(project => (
      <article class="project-card" data-reveal data-tone={project.key} id={'project-' + project.key}>
        <div class="work-visual">
          <a class="work-image" href={project.demo} target={project.demo.startsWith('https:') ? '_blank' : undefined} rel={project.demo.startsWith('https:') ? 'noopener noreferrer' : undefined} aria-label={(en ? 'Try ' : 'Probar ') + project.title}>
            <img {...project.image} src={'/' + project.image.src} decoding="async" />
          </a>
          <button class="card-expand" type="button" data-capture={project.key} aria-label={(en ? 'Enlarge screenshot of ' : 'Ampliar captura de ') + project.title}>⤢</button>
        </div>
        <div class="project-content">
          <h3>{project.title}</h3>
          <p>{project.description}</p>
          <p class="stack" set:html={project.stack} />
          <div class="work-actions">
            <a class="action primary demo-button" href={project.demo} target={project.demo.startsWith('https:') ? '_blank' : undefined} rel={project.demo.startsWith('https:') ? 'noopener noreferrer' : undefined}>{en ? 'Try demo' : 'Probar demo'} ↗</a>
            <button type="button" class="action secondary" data-project={project.key}>{en ? 'Case study' : 'Ver caso'}</button>
            <a class="text-link" href={project.code} target="_blank" rel="noopener noreferrer">{en ? 'Code' : 'Código'} ↗</a>
          </div>
        </div>
      </article>
    ))}
  </div>
</section>
