---
import '../styles/site.css';
const { lang } = Astro.props;
const en = lang === 'en';
const examples = en ? [
  ['Q-01', 'Disputed charge', 'I’ve asked twice about this charge.', 'I’ll ask Billing to review it.', 'Ticket closed. No follow-up was recorded.', 'A repeat complaint was closed without a resolution.'],
  ['Q-02', 'Sign-in test', 'I saw “I’ve asked twice” in the training example.', 'That phrase is example text. Can you sign in now?', 'Yes. I can sign in and see my account.', 'The rule matched the phrase “I’ve asked twice”.'],
] : [
  ['Q-01', 'Cargo en disputa', 'Es la segunda vez que pregunto por este cargo.', 'Voy a pedirle a Facturación que lo revise.', 'Se cerró el ticket. No quedó seguimiento registrado.', 'Se cerró un reclamo repetido sin resolución.'],
  ['Q-02', 'Prueba de inicio de sesión', 'Vi «es la segunda vez» en el ejemplo de capacitación.', 'Esa frase es de un ejemplo. ¿Ya puedes ingresar?', 'Sí. Ya puedo entrar y veo mi cuenta.', 'La regla encontró la frase «es la segunda vez».'],
];
const home = en ? '/en' : '/';
const path = en ? '/en/projects/quality-review' : '/proyectos/revision-calidad';
const title = en ? 'Ticket quality review' : 'Revisión de calidad de tickets';
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Lucas Nieto</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="description" content={en ? 'Review two fictional support conversations and record your quality decisions.' : 'Revisa dos conversaciones ficticias y registra tus decisiones de calidad.'} />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <link rel="alternate" hreflang="es" href={new URL('/proyectos/revision-calidad', Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL('/en/projects/quality-review', Astro.site)} />
    <script is:inline src="/theme-init.js"></script>
  </head>
  <body>
    <a class="skip" href="#main">{en ? 'Skip to content' : 'Ir al contenido'}</a>
    <header class="site-header glass"><div class="wrap header-row">
      <a class="brand" href={home}>Lucas Nieto</a>
      <div class="languages" aria-label={en ? 'Language' : 'Idioma'}>
        <a href="/proyectos/revision-calidad" lang="es" aria-current={!en ? 'page' : undefined}>ES</a>
        <a href="/en/projects/quality-review" lang="en" aria-current={en ? 'page' : undefined}>EN</a>
      </div>
    </div></header>
    <main class="wrap case-page" id="main">
      <a class="text-link case-back" href={home + '#proyectos'}>← {en ? 'Selected projects' : 'Proyectos seleccionados'}</a>
      <div class="case-grid quality-intro">
        <div><p class="eyebrow">{en ? 'Interactive prototype' : 'Prototipo interactivo'}</p><h1>{title}</h1></div>
        <p class="intro">{en ? 'Two conversations were flagged for review. Read the evidence, decide which flag warrants follow-up and check the decision log.' : 'Dos conversaciones fueron marcadas para revisión. Lee la evidencia, decide qué alerta merece seguimiento y consulta el historial.'}</p>
      </div>
      <p class="quality-note">{en ? 'Fictional conversations and sample rule matches. Your decisions stay in this browser tab.' : 'Conversaciones ficticias y ejemplos de coincidencias por reglas. Tus decisiones quedan en esta pestaña.'}</p>
      <div class="case-grid case-details quality-grid" data-review>
        {examples.map(([id, subject, first, second, last, reason]) => (
          <section class="surface">
            <p class="eyebrow">{id}</p>
            <h2>{subject}</h2>
            <ul class="quality-conversation">
              <li>{first}</li><li>{second}</li><li>{last}</li>
            </ul>
            <p class="quality-reason"><strong>{en ? 'Why it was flagged' : 'Motivo de la alerta'}</strong><br />{reason}</p>
            <div class="work-actions">
              <button class="action primary" type="button" data-ticket={id} data-decision="confirm" hidden>{en ? 'Confirm flag' : 'Confirmar alerta'}</button>
              <button class="action secondary" type="button" data-ticket={id} data-decision="dismiss" hidden>{en ? 'Mark false positive' : 'Marcar falso positivo'}</button>
            </div>
          </section>
        ))}
      </div>
      <section class="surface quality-log" data-log hidden>
        <h2>{en ? 'Decision log' : 'Historial de decisiones'}</h2>
        <p data-feedback role="status"></p>
        <ol data-entries></ol>
        <button class="action secondary" type="button" data-reset>{en ? 'Reset decisions' : 'Reiniciar decisiones'}</button>
      </section>
      <a class="text-link" href={home + '#contacto'}>{en ? 'Contact Lucas' : 'Contactar a Lucas'} →</a>
    </main>
    <script>
      const key = 'portfolio-quality-review';
      const en = document.documentElement.lang === 'en';
      const log = document.querySelector('[data-log]');
      const entries = document.querySelector('[data-entries]');
      const feedback = document.querySelector('[data-feedback]');
      const buttons = [...document.querySelectorAll('[data-decision]')];
      const descriptions = en
        ? { confirm: 'Flag confirmed', dismiss: 'False positive' }
        : { confirm: 'Alerta confirmada', dismiss: 'Falso positivo' };
      let decisions = [];
      try {
        const stored = JSON.parse(sessionStorage.getItem(key) ?? '[]');
        if (Array.isArray(stored)) decisions = stored.filter(item => item && buttons.some(button => button.dataset.ticket === item.ticket && button.dataset.decision === item.decision));
      } catch {}
      function render() {
        buttons.forEach(button => {
          const latest = decisions.findLast(item => item.ticket === button.dataset.ticket);
          button.setAttribute('aria-pressed', String(latest?.decision === button.dataset.decision));
        });
        entries.replaceChildren(...decisions.map(item => {
          const entry = document.createElement('li');
          entry.textContent = item.ticket + ' · ' + descriptions[item.decision];
          return entry;
        }));
      }
      function persist(message) {
        try { sessionStorage.setItem(key, JSON.stringify(decisions)); } catch {}
        render();
        feedback.textContent = message;
      }
      buttons.forEach(button => {
        button.hidden = false;
        button.addEventListener('click', () => {
          const { ticket, decision } = button.dataset;
          if (decisions.findLast(item => item.ticket === ticket)?.decision === decision) return;
          decisions.push({ ticket, decision });
          persist(ticket + ' · ' + descriptions[decision]);
        });
      });
      document.querySelector('[data-reset]').addEventListener('click', () => {
        decisions = [];
        persist(en ? 'Decisions cleared.' : 'Se borraron las decisiones.');
      });
      render();
      log.hidden = false;
    </script>
  </body>
</html>
